<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.begifted.hiring</string>
  <key>ProgramArguments</key>
  <array>
    <string>NODE24_ABSOLUTE_PATH</string>
    <string>RELEASE_CHECKOUT/node_modules/tsx/dist/cli.mjs</string>
    <string>--tsconfig</string><string>scripts/tsconfig.json</string>
    <string>scripts/hiring-worker.ts</string><string>--watch</string>
  </array>
  <key>WorkingDirectory</key><string>RELEASE_CHECKOUT</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>NODE24_BIN_DIRECTORY:CLAUDE_BIN_DIRECTORY:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>60</integer>
  <key>StandardOutPath</key><string>USER_HOME/.bgscheduler-hiring/worker.log</string>
  <key>StandardErrorPath</key><string>USER_HOME/.bgscheduler-hiring/worker-error.log</string>
</dict>
</plist>
