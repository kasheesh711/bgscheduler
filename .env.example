# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Auth.js
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Wise API
WISE_USER_ID=your-wise-user-id
WISE_API_KEY=your-wise-api-key
WISE_NAMESPACE=begifted-education
WISE_INSTITUTE_ID=696e1f4d90102225641cc413

# Cron
CRON_SECRET=generate-a-secure-random-string

# AI scheduler
OPENAI_API_KEY=sk-...
OPENAI_SCHEDULER_MODEL=gpt-5.4-mini
ENABLE_AI_SCHEDULER=true

# LINE scheduler
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
ENABLE_LINE_SCHEDULER=true

# Student monthly schedule
# Live Wise overlay for /schedule: sweeps the requested month directly from
# Wise on each read so a reschedule/cancellation/new class is visible before
# the next credit-control sync promotes. Opt-out -- set to exactly "false" to
# disable and fall back to snapshot-only rendering with zero code change.
ENABLE_STUDENT_SCHEDULE_LIVE=true
# Comma-separated LINE user IDs allowed to drive the schedule bot. LEAVE BLANK
# to keep the bot disabled — an empty allowlist is the fail-closed default, and
# any LINE user listed here can push a student's schedule to that student's
# verified parent contact. Covers the admin operator team, not a single person
# — run `npm run line:find-user-ids` to harvest a new operator's ID from their
# onboarding DM.
LINE_SCHEDULE_BOT_ADMIN_IDS=
# Days a parent schedule link stays live (default 30).
STUDENT_SCHEDULE_LINK_TTL_DAYS=30
# Absolute origin used to build parent links. Leave blank to use the request
# origin, so preview deployments link to themselves.
APP_BASE_URL=

# Schedule emails
SCHEDULE_EMAIL_APPS_SCRIPT_URL=https://script.google.com/macros/s/your-deployment-id/exec
SCHEDULE_EMAIL_APPS_SCRIPT_SECRET=shared-secret-with-apps-script
SCHEDULE_EMAIL_BACKUP_APPS_SCRIPT_URL=https://script.google.com/macros/s/your-backup-deployment-id/exec
SCHEDULE_EMAIL_BACKUP_APPS_SCRIPT_SECRET=shared-secret-with-backup-apps-script
SCHEDULE_EMAIL_SENDER_NAME=BeGifted
SCHEDULE_EMAIL_REPLY_TO=admin@your-domain.com

# Tutor leave requests
LEAVE_REQUESTS_SPREADSHEET_ID=109o2vbmxlJ-l2U18Rs_WrjD7TMF5b6h__GiNkkQIfS8
LEAVE_REQUESTS_SHEET_NAME=Form Responses 1
LEAVE_REQUESTS_CONNECTED_EMAIL=admin-google-account-with-sheets-write-scope@example.com
NEXT_PUBLIC_APP_URL=https://bgscheduler.vercel.app

# Post-Class Feedback payout target
# Preview deployments must use scratch; production deployments must use production.
# External writes stay disabled unless the value is exactly true.
POST_CLASS_PAYOUT_TARGET=scratch
POST_CLASS_PAYOUT_CONNECTED_EMAIL=finance-google-account-with-sheets-and-drive-scope@example.com
POST_CLASS_PAYOUT_DRIVE_FOLDER_ID=
POST_CLASS_PAYOUT_WORKBOOKS_FOLDER_ID=
POST_CLASS_PAYOUT_MASTER_SPREADSHEET_ID=
POST_CLASS_PAYOUT_SOURCE_SHEET_NAME=Begifted Payouts Detailed
POST_CLASS_PAYOUT_DEDUCTIONS_SHEET_NAME=Feedback Deductions
POST_CLASS_PAYOUT_COMPOSITE_SHEET_NAME=Payouts With Deductions
POST_CLASS_PAYOUT_WRITES_ENABLED=false
