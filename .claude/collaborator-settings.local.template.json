{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.vercel/**)",
      "Read(./*.xlsx)",
      "Read(./*.xls)",
      "Read(./*.pem)",
      "Read(./*.key)",
      "Read(./*.p12)",
      "Bash(npx vercel --prod:*)",
      "Bash(vercel --prod:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(npm install:*)",
      "Bash(npx shadcn:*)"
    ],
    "disableBypassPermissionsMode": "disable"
  }
}
